PORT=5000
MONGO_URI=
JWT_SECRET=
CLIENT_URL=https://rohinth375.github.io
NODE_ENV=development

# Optional — enables POST /api/admin/rebuild-site (GitHub PAT with `repo` +
# `workflow` scope, or a fine-grained token with Actions: write on the repo).
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=ROHINTH375/my_Journal_FE
GITHUB_DISPATCH_WORKFLOW=deploy.yml
